{
  "$defs": {
    "UploadRequest": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "maximum": 33554432,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "text/plain",
            "application/pdf",
            "image/png",
            "image/jpeg"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "CHAT_ATTACHMENT",
            "KNOWLEDGE_SOURCE"
          ],
          "title": "Purpose",
          "type": "string"
        }
      },
      "required": [
        "purpose",
        "byte_size",
        "content_sha256",
        "media_type"
      ],
      "title": "UploadRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/UploadRequest"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "upload_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Upload Ref",
      "type": "string"
    }
  },
  "required": [
    "expires_at",
    "upload_ref",
    "tenant_id",
    "actor_id",
    "request"
  ],
  "title": "UploadPermit",
  "type": "object"
}
