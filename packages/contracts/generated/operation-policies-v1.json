{
  "errors": {
    "ACCESS_DENIED": {
      "client_action": "STOP",
      "envelope": "error",
      "http_statuses": [
        403,
        404
      ],
      "retry_policy": "NEVER"
    },
    "AUTH_REQUIRED": {
      "client_action": "REAUTHENTICATE",
      "envelope": "error",
      "http_statuses": [
        401
      ],
      "retry_policy": "NEVER"
    },
    "COMMAND_RESULT_UNKNOWN": {
      "client_action": "QUERY_COMMAND",
      "envelope": "data",
      "http_statuses": [
        202,
        200
      ],
      "retry_policy": "QUERY_OR_RECONCILE"
    },
    "CONFIRMATION_EXPIRED": {
      "client_action": "REFRESH_AND_RECONFIRM",
      "envelope": "error",
      "http_statuses": [
        409
      ],
      "retry_policy": "NEVER"
    },
    "DEADLINE_EXCEEDED": {
      "client_action": "QUERY_COMMAND",
      "envelope": "error",
      "http_statuses": [
        504
      ],
      "retry_policy": "QUERY_OR_RECONCILE"
    },
    "IDEMPOTENCY_CONFLICT": {
      "client_action": "QUERY_ORIGINAL_REQUEST",
      "envelope": "error",
      "http_statuses": [
        409
      ],
      "retry_policy": "NEVER"
    },
    "INPUT_INVALID": {
      "client_action": "FIX_REQUEST",
      "envelope": "error",
      "http_statuses": [
        422
      ],
      "retry_policy": "NEVER"
    },
    "PUBLICATION_FAILED": {
      "client_action": "READ_SNAPSHOT",
      "envelope": "error",
      "http_statuses": [
        503
      ],
      "retry_policy": "REPUBLISH_SAME_RESULT"
    },
    "RATE_LIMITED": {
      "client_action": "HONOR_RETRY_AFTER",
      "envelope": "error",
      "http_statuses": [
        429
      ],
      "retry_policy": "BOUNDED_BACKOFF"
    },
    "RUN_SUPERSEDED": {
      "client_action": "READ_SNAPSHOT",
      "envelope": "error",
      "http_statuses": [
        409
      ],
      "retry_policy": "NEVER"
    },
    "SCHEMA_UNSUPPORTED": {
      "client_action": "QUARANTINE_AND_ALERT",
      "envelope": "error",
      "http_statuses": [
        422
      ],
      "retry_policy": "QUARANTINE"
    },
    "UPSTREAM_UNAVAILABLE": {
      "client_action": "CHECK_OPERATION_SAFETY",
      "envelope": "error",
      "http_statuses": [
        503
      ],
      "retry_policy": "SAFE_READ_OR_SAME_COMMAND"
    },
    "VERSION_CONFLICT": {
      "client_action": "REFRESH_AND_RECONFIRM",
      "envelope": "error",
      "http_statuses": [
        409
      ],
      "retry_policy": "NEVER"
    }
  },
  "idempotency_scope": [
    "tenant_id",
    "initiating_actor_id",
    "operation",
    "target_scope",
    "idempotency_key"
  ],
  "numeric_deadlines": "UNFROZEN_M17",
  "operations": {
