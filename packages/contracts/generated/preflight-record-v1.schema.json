{
  "$defs": {
    "Application": {
      "additionalProperties": false,
      "properties": {
        "application_type": {
          "enum": [
            "RETURN_REFUND",
            "REFUND_ONLY",
            "EXCHANGE",
            "REPAIR",
            "RESEND"
          ],
          "title": "Application Type",
          "type": "string"
        },
        "attachment_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Attachment Refs",
          "type": "array"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/ApplicationLine"
          },
          "maxItems": 50,
          "minItems": 1,
          "title": "Lines",
          "type": "array"
        },
        "operation": {
          "const": "after_sales.apply",
          "title": "Operation",
          "type": "string"
        },
        "order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Order Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "application_type",
        "order_id",
        "lines",
        "reason",
        "attachment_refs"
      ],
      "title": "Application",
      "type": "object"
    },
    "ApplicationLine": {
      "additionalProperties": false,
      "properties": {
        "order_line_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Order Line Id",
          "type": "string"
        },
        "quantity": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        }
      },
      "required": [
        "order_line_id",
        "quantity"
      ],
      "title": "ApplicationLine",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "minor_units": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Minor Units",
          "type": "integer"
        }
      },
      "required": [
        "minor_units",
        "currency"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Actor Id",
      "type": "string"
    },
    "application": {
      "$ref": "#/$defs/Application"
    },
    "command_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Command Id"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "preflight_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Preflight Id",
      "type": "string"
    },
    "quoted_amount": {
      "anyOf": [
        {
          "$ref": "#/$defs/Money"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Resource Version",
      "type": "string"
    },
    "rule_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Rule Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "PENDING",
        "USED",
        "INVALIDATED",
        "EXPIRED"
      ],
      "title": "State",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "preflight_id",
    "tenant_id",
    "actor_id",
    "application",
    "quoted_amount",
    "resource_version",
    "rule_version",
    "payload_hash",
    "expires_at",
    "state",
    "command_id"
  ],
  "title": "PreflightRecord",
  "type": "object"
}
