{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "client_action": {
            "default": "FIX_REQUEST",
            "title": "Client Action",
            "type": "string"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "command_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command Id"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "default": false,
            "title": "Retryable",
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "Failure": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "trace_id",
          "error"
        ],
        "title": "Failure",
        "type": "object"
      },
      "Health": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "scope": {
            "default": "application",
            "title": "Scope",
            "type": "string"
          },
          "service": {
            "default": "api-gateway",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Health",
        "type": "object"
      },
      "Success_Health_": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Health"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "trace_id",
          "data"
        ],
        "title": "Success[Health]",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "应用骨架；显式启用数据库时检查连接和迁移版本。不表示 RAG 或业务已可用。",
    "title": "智能电商客服 API Gateway",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success_Health_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Live",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Success_Health_"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Ready",
        "tags": [
          "health"
        ]
      }
    }
  }
}
