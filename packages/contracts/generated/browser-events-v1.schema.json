    "Committed": {
      "additionalProperties": false,
      "properties": {
        "control_epoch": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Control Epoch",
          "type": "integer"
        },
        "conversation_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "cursor": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Cursor",
          "type": "string"
        },
        "event_type": {
          "const": "message.committed",
          "title": "Event Type",
          "type": "string"
        },
        "message_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Message Id",
          "type": "string"
        },
        "message_seq": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Message Seq",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Run Id"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "conversation_id",
        "control_epoch",
        "event_type",
        "cursor",
        "run_id",
        "message_id",
        "message_seq"
      ],
      "title": "Committed",
      "type": "object"
    },
