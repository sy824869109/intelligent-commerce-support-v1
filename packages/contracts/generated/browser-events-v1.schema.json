  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "answer.delta": "#/$defs/Delta",
      "control.changed": "#/$defs/Control",
      "message.committed": "#/$defs/Committed",
      "resync_required": "#/$defs/Resync",
      "run.completed": "#/$defs/Completed",
      "run.failed": "#/$defs/Failed",
      "run.progress": "#/$defs/Progress",
      "run.started": "#/$defs/Started"
