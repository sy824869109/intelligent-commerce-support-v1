# Copy to _local_artifacts/environment/model.env. Never commit real credentials.
# Cloud endpoint must be HTTPS; configure your selected provider privately.
# Beijing conventional endpoint; use the exact console endpoint for other regions/workspaces.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
# Local inference starts on CPU to preserve KF compatibility and GPU memory.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
LANGSMITH_TRACING=false
