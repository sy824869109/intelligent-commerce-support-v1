# 应用基础配置
APP_NAME=intelligent-commerce-support-v1
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost

# 安全配置：仅为占位符，禁止在仓库中填写真实密钥
JWT_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=intelligent_support
MYSQL_USER=intelligent_support
MYSQL_PASSWORD=replace_me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace_me
REDIS_DATABASE=0

# MinIO / S3-compatible storage
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=replace_me
OBJECT_STORAGE_SECRET_KEY=replace_me
OBJECT_STORAGE_BUCKET=knowledge
OBJECT_STORAGE_SECURE=false

# Milvus / etcd
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=default
ETCD_ENDPOINTS=http://127.0.0.1:2379

# OpenAI-compatible 模型接口
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=replace_me
LLM_MODEL=qwen3-8b
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 可观测性
OTEL_SERVICE_NAME=intelligent-commerce-support
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
METRICS_ENABLED=true
TRACING_ENABLED=true
